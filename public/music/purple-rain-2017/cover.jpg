<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000" width="1000" height="1000">
  <defs>
    <linearGradient id="skyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a0217" />
      <stop offset="30%" stop-color="#1e0638" />
      <stop offset="60%" stop-color="#3d0c5a" />
      <stop offset="85%" stop-color="#24043b" />
      <stop offset="100%" stop-color="#070110" />
    </linearGradient>
    <radialGradient id="neonGlow" cx="50%" cy="58%" r="45%">
      <stop offset="0%" stop-color="#c77dff" stop-opacity="0.85" />
      <stop offset="35%" stop-color="#7b2cbf" stop-opacity="0.45" />
      <stop offset="70%" stop-color="#3c096c" stop-opacity="0.2" />
      <stop offset="100%" stop-color="#10002b" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="wetStreet" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#100520" />
      <stop offset="40%" stop-color="#240a3e" />
      <stop offset="75%" stop-color="#4a154b" />
      <stop offset="100%" stop-color="#0d0318" />
    </linearGradient>
    <linearGradient id="goldRemaster" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#bf953f" />
      <stop offset="25%" stop-color="#fcf6ba" />
      <stop offset="50%" stop-color="#b38728" />
      <stop offset="75%" stop-color="#fbf5b7" />
      <stop offset="100%" stop-color="#aa771c" />
    </linearGradient>
    <filter id="blurLight" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="40" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Deep Atmospheric Background -->
  <rect width="1000" height="1000" fill="url(#skyGrad)" />
  
  <!-- Wet Asphalt / Street Reflection -->
  <rect y="550" width="1000" height="450" fill="url(#wetStreet)" />
  
  <!-- Fog & Violet Street Neon Glow -->
  <circle cx="500" cy="560" r="380" fill="url(#neonGlow)" filter="url(#blurLight)" />
  
  <!-- Rain Texture Streaks -->
  <g stroke="#e0aaff" stroke-opacity="0.12" stroke-width="1.2" stroke-linecap="round">
    <line x1="120" y1="40" x2="100" y2="180" />
    <line x1="280" y1="120" x2="260" y2="300" />
    <line x1="450" y1="60" x2="430" y2="240" />
    <line x1="620" y1="100" x2="600" y2="290" />
    <line x1="790" y1="50" x2="770" y2="220" />
    <line x1="910" y1="140" x2="890" y2="320" />
    <line x1="180" y1="360" x2="160" y2="520" />
    <line x1="350" y1="400" x2="330" y2="580" />
    <line x1="680" y1="380" x2="660" y2="560" />
    <line x1="840" y1="420" x2="820" y2="600" />
    <line x1="220" y1="650" x2="200" y2="820" />
    <line x1="510" y1="680" x2="490" y2="850" />
    <line x1="760" y1="660" x2="740" y2="830" />
  </g>

  <!-- Misty City Silhouette & Tenement Fire Escape -->
  <g fill="#0b0314" opacity="0.85">
    <rect x="60" y="240" width="180" height="420" />
    <rect x="760" y="200" width="190" height="460" />
    <!-- Distant industrial pipes & neon signs -->
    <rect x="90" y="270" width="30" height="50" fill="#ff007f" opacity="0.4" filter="url(#blurLight)" />
    <rect x="800" y="250" width="30" height="60" fill="#9d4edd" opacity="0.4" filter="url(#blurLight)" />
  </g>

  <!-- Motorcycle & Rider Silhouette Silhouette -->
  <g fill="#05010a" stroke="#240046" stroke-width="2">
    <!-- Motorcycle Wheels & Frame -->
    <circle cx="410" cy="740" r="75" />
    <circle cx="590" cy="740" r="75" />
    <path d="M410,740 L480,670 L550,670 L590,740 L530,750 L460,750 Z" />
    <!-- Windshield & Handlebars -->
    <path d="M480,670 L450,590 L480,570 L520,640 Z" fill="#1a042e" />
    <!-- Iconic Silhouette of Prince in purple trench coat -->
    <path d="M490,560 Q500,510 495,470 Q515,465 525,485 Q540,530 545,610 L525,670 L475,670 Z" fill="#0c0217" />
    <!-- Chrome Headlight Flare -->
    <circle cx="445" cy="620" r="14" fill="#ffffff" filter="url(#blurLight)" opacity="0.9" />
    <circle cx="445" cy="620" r="35" fill="#e0aaff" filter="url(#blurLight)" opacity="0.6" />
  </g>

  <!-- Wet Street Light Reflections -->
  <ellipse cx="445" cy="780" rx="40" ry="18" fill="#e0aaff" opacity="0.35" filter="url(#blurLight)" />
  <ellipse cx="500" cy="820" rx="160" ry="25" fill="#7b2cbf" opacity="0.4" filter="url(#blurLight)" />

  <!-- Outer Fine Framing Line -->
  <rect x="25" y="25" width="950" height="950" fill="none" stroke="#7b2cbf" stroke-width="1.5" stroke-opacity="0.4" />
  <rect x="35" y="35" width="930" height="930" fill="none" stroke="#e0aaff" stroke-width="0.75" stroke-opacity="0.25" />

  <!-- Top Artist Header: PRINCE AND THE REVOLUTION -->
  <text x="500" y="105" text-anchor="middle" font-family="'Playfair Display', 'Georgia', serif" font-size="28" font-weight="700" letter-spacing="10" fill="#f3e8ff" opacity="0.95">
    PRINCE AND THE REVOLUTION
  </text>
  
  <!-- Title: PURPLE RAIN -->
  <g id="titleText">
    <text x="500" y="185" text-anchor="middle" font-family="'Playfair Display', 'Times New Roman', serif" font-size="76" font-style="italic" font-weight="900" letter-spacing="4" fill="#c77dff" filter="url(#blurLight)" opacity="0.5">
      Purple Rain
    </text>
    <text x="500" y="185" text-anchor="middle" font-family="'Playfair Display', 'Times New Roman', serif" font-size="76" font-style="italic" font-weight="900" letter-spacing="4" fill="#ffffff">
      Purple Rain
    </text>
  </g>

  <!-- Remaster Gold Ribbon Badge -->
  <g transform="translate(500, 915)">
    <rect x="-180" y="-18" width="360" height="36" rx="18" fill="#0d031a" stroke="url(#goldRemaster)" stroke-width="1.5" />
    <text x="0" y="5" text-anchor="middle" font-family="'Inter', -apple-system, sans-serif" font-size="12" font-weight="700" letter-spacing="5" fill="url(#goldRemaster)">
      2017 PAISLEY PARK REMASTER
    </text>
  </g>
</svg>
